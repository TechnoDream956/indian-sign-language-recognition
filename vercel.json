{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "framework": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS, PUT, DELETE"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Requested-With, X-Session-Token, X-User-ID, X-Session-ID"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "X-Session-Token"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://isl-recognition-backend.onrender.com/api/:match*"
    },
    {
      "source": "/events",
      "destination": "https://isl-recognition-backend.onrender.com/events"
    },
    {
      "source": "/video_feed",
      "destination": "https://isl-recognition-backend.onrender.com/video_feed"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
