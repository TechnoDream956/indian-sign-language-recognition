# ==============================================================================
# Vercel Deployment Ignore Configuration (.vercelignore)
# STATIC FRONTEND ONLY — Exclude all Python backend, ML packages & heavy models
# ==============================================================================

# Backend Python files & environments (Hosted exclusively on Render)
src/
requirements.txt
run_app.sh
venv/
.venv/
__pycache__/
*.py
*.pyc

# Machine Learning models & weights (exceeds Vercel limits, loaded on Render)
models/
*.h5
*.keras
*.tflite
*.pt
*.pth
*.onnx

# Datasets, training reserves & historical experiments
data/
reserve/
packaging/
tools/
assets/
docs/

# Tests & benchmarks
tests/
.pytest_cache/

# Cloud container orchestration (Render & Docker only)
Dockerfile*
docker-compose*
render.yaml

# System & IDE artifacts
.git/
.gitignore
.DS_Store
*.log
